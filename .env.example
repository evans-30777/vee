# Copy to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=veeagency.co.ke,www.veeagency.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://veeagency.co.ke,https://www.veeagency.co.ke
SITE_BASE_URL=https://veeagency.co.ke

# Database (production uses SQLite — HostAfrica does not offer PostgreSQL).
# MUST point outside the public web root, or the file is downloadable and
# exposes every enquiry and password hash. See DEPLOYMENT.md.
SQLITE_PATH=/home/<cpanel-user>/vee-data/db.sqlite3

# Email / SMTP — enquiry notifications
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=hello@veeagency.co.ke
ENQUIRY_NOTIFICATION_EMAIL=hello@veeagency.co.ke
